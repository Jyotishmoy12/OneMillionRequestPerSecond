# API
PORT=8080

# Local Docker Compose database connection.
# Inside Compose, the hostname is the service name: postgres.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/onemillionrps?sslmode=disable

# Local Docker Compose Valkey/Redis connection.
# Inside Compose, the hostname is the service name: redis.
REDIS_ADDR=redis:6379

# Postgres connection pool.
# Current local benchmark decision: 50 max / 10 min.
DB_MAX_CONNS=50
DB_MIN_CONNS=10

# Local Grafana login from docker-compose.yml.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
